[Unit]
Description=Konmai Backbone node agent
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=konmai
Group=konmai
WorkingDirectory=/srv/konmai/app/node
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/konmai/app/node/dist/main.js --config /etc/konmai/node.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
